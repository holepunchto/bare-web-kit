{
  "name": "bare-web-kit",
  "version": "0.1.2",
  "description": "WebKit bindings for Bare",
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "binding.m",
    "binding.js",
    "CMakeLists.txt",
    "lib",
    "prebuilds"
  ],
  "addon": true,
  "scripts": {
    "format": "prettier --write . && lunte --fix",
    "lint": "prettier --check . && lunte",
    "test": "brittle-bare --coverage test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/bare-web-kit.git"
  },
  "author": "Holepunch",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/bare-web-kit/issues"
  },
  "homepage": "https://github.com/holepunchto/bare-web-kit#readme",
  "dependencies": {
    "bare-events": "^2.8.2",
    "bare-foundation-registry": "^0.1.0",
    "require-asset": "^1.1.0"
  },
  "devDependencies": {
    "brittle": "^3.18.0",
    "cmake-bare": "^1.6.5",
    "lunte": "^1.8.4",
    "prettier": "^3.4.1",
    "prettier-config-holepunch": "^2.0.0"
  }
}
